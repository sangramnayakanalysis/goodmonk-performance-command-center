# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# In GitHub Actions, these same names are set as repository Secrets instead
# (see .github/workflows/monitor.yml) — .env is only used for local runs.

# --- GTmetrix -----------------------------------------------------------
GTMETRIX_API_KEY=your_gtmetrix_api_key_here
GTMETRIX_LOCATION=24
GTMETRIX_BROWSER=3

# --- Networking / retries --------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY_SECONDS=3
RATE_LIMIT_WAIT_SECONDS=30
POLL_MAX_ATTEMPTS=24
POLL_INTERVAL_SECONDS=15
MAX_WORKERS=4

# --- Google Sheets -----------------------------------------------------------
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Local development: path to a downloaded service-account key file.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# CI (GitHub Actions): paste the whole JSON key content into a repo secret
# named GOOGLE_SERVICE_ACCOUNT_JSON instead — leave this blank locally.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Email (optional — leave blank to disable email reports) ---------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Alert thresholds --------------------------------------------------
ALERT_SCORE_THRESHOLD=80
ALERT_LCP_THRESHOLD_SECONDS=2.5

# --- Root Cause Analysis thresholds (Feature 1 — all optional, sensible
#     defaults are used if left blank) --------------------------------------
RCA_TTFB_THRESHOLD_SECONDS=0.8
RCA_LCP_THRESHOLD_SECONDS=2.5
RCA_CLS_THRESHOLD=0.1
RCA_TBT_THRESHOLD_SECONDS=0.2
RCA_FULLY_LOADED_THRESHOLD_SECONDS=5.0
RCA_PAGE_BYTES_THRESHOLD_MB=3.0
RCA_IMAGE_BYTES_THRESHOLD_MB=1.5
RCA_JS_BYTES_THRESHOLD_KB=500
RCA_CSS_BYTES_THRESHOLD_KB=150
RCA_FONT_BYTES_THRESHOLD_KB=300
RCA_THIRD_PARTY_BYTES_THRESHOLD_KB=400
RCA_REQUEST_COUNT_THRESHOLD=80
RCA_DOM_ELEMENTS_THRESHOLD=1500
RCA_MAX_ISSUES_IN_EMAIL=5

# --- Customer Journey Monitoring (Feature 2 — all optional, sensible
#     defaults are used if left blank) --------------------------------------
JOURNEY_ENABLED=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_MS=30000
PLAYWRIGHT_ACTION_TIMEOUT_MS=10000
JOURNEY_MAX_RETRIES=2
JOURNEY_RETRY_BASE_DELAY_SECONDS=2
JOURNEY_SCREENSHOT_ON_SUCCESS=false
JOURNEY_HOMEPAGE_URL=https://www.goodmonk.in/
JOURNEY_COLLECTION_URL=https://www.goodmonk.in/collections/all
JOURNEY_CART_URL=https://www.goodmonk.in/cart
# NOTE: which specific products are tested (JOURNEY_PRODUCTS) and the
# selector strategy (JOURNEY_SELECTORS) are structured data, not simple
# scalars — they live directly in config.py, not here. See README §11.

# --- Smart Alert System (Feature 3 — all optional, sensible defaults
#     are used if left blank) ------------------------------------------
ALERT_ENABLED=true
ALERT_SCORE_DROP_THRESHOLD=10
ALERT_GRADE_DROP_ENABLED=true
ALERT_MIN_RCA_SEVERITY=warning
ALERT_ALL_PAGES_FAILED_IS_SYSTEMIC=true
# NOTE: the per-alert-type severity registry (ALERT_SEVERITY_MAP) is
# structured data, not a simple scalar — it lives directly in config.py.
# See README §12.

# --- Intelligent Monitoring Scheduler (Feature 4 — all optional,
#     sensible defaults are used if left blank) ---------------------------
SCHEDULER_ENABLED=true
SCHEDULER_DUE_TOLERANCE_MINUTES=5
# NOTE: per-page priority/interval_hours and feature toggles
# (gtmetrix_enabled, journey_enabled, root_cause_enabled, alert_enabled)
# are structured data, not simple scalars — they live directly on each
# Page(...) entry in config.py. See README §13.
